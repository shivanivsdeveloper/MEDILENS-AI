# MediScan AI Configuration Template
PROJECT_NAME="MediScan AI"
VERSION="2.5.0"
DEBUG=True
ENVIRONMENT="development"

# Database
DATABASE_URL="sqlite:///./mediscan.db"

# Storage
MAX_UPLOAD_SIZE_MB=50

# Risk Engine Thresholds
RISK_HIGH_THRESHOLD=0.70
