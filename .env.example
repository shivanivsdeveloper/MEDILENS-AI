# MediScan AI Configuration Template (Production & Development)
PROJECT_NAME="MediScan AI"
VERSION="2.5.0"
DEBUG=False
ENVIRONMENT="production"
PORT=8000

# Database (SQLite default; PostgreSQL optional on Render)
DATABASE_URL="sqlite:///./mediscan.db"

# Security & CORS
CORS_ORIGINS="http://localhost:5173,https://*.vercel.app,*"

# Storage Limits
MAX_UPLOAD_SIZE_MB=50

# Clinical AI Risk Engine Thresholds
RISK_HIGH_THRESHOLD=0.70
RISK_MODERATE_THRESHOLD=0.40
UNCERTAINTY_HIGH_THRESHOLD=0.35
QUALITY_MIN_ACCEPTABLE=40

# Localization
DEFAULT_LANGUAGE="en"

# Frontend Vercel Environment Variable:
# VITE_API_URL="https://your-mediscan-backend.onrender.com"
